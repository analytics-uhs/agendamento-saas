NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Prefer the current publishable key. The legacy anon key is also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
NEXT_PUBLIC_APP_DOMAIN=agenda.local

# Server-only. Never expose these values to the browser or commit real keys.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:notifications@example.com
